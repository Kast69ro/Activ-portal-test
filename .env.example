# Скопируйте в .env и при необходимости поправьте адреса.
# Значения по умолчанию — внутренние адреса из прежней HR-системы.

# Основной API: оргструктура, тесты, база знаний, авторизация (без /api на конце)
VITE_API_URL=http://10.65.10.22:8525

# Чат: REST и WebSocket
VITE_CHAT_API_URL=http://10.65.10.22:7463

# Статьи и комментарии

# Стажёры и одноразовые ссылки на тесты
VITE_INTERNS_API_URL=http://10.65.10.22:8083

# Мониторинг банкоматов (PHP-сервис, без /services на конце).
# При разработке — /atm-api: прокси Vite на http://10.64.1.10 (см. vite.config.js).
# В продакшене — адрес прокси на вашем сервере или http://10.64.1.10, если сервис разрешает CORS.
VITE_ATM_API_URL=/atm-api

# Транзакции по банкоматам (без /api на конце)
VITE_TRANSACTIONS_API_URL=http://10.64.20.84:5003

# Курсы Нацбанка Таджикистана. При разработке не задавайте — работает прокси Vite (/nbt-rates).
# В продакшене — адрес прокси на вашем сервере, который передаёт ?date=&export=xmlout на nbt.tj/ru/kurs/export_xml.php
